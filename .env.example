# GEM & CRYSTAL FASHION HUB — Storefront Environment

# ── API Backend ────────────────────────────────────────────────────────────
# Production: set to your deployed API URL e.g. https://api.gemandcrystal.co.ke
# Development: leave empty — Vite proxies /api → localhost:4000 automatically
VITE_API_URL=

# ── AI Chat ────────────────────────────────────────────────────────────────
# Leave empty in dev (same-origin /api proxy handles it).
# Set in production only if your API is on a different domain.
# The AI API key is NEVER stored here — it lives only in the backend .env
# VITE_API_URL already covers this; no separate AI URL is needed.

# ── Demo / Development Fallback ────────────────────────────────────────────
# Set to "true" ONLY in development to load local demo products when the API
# is unavailable. NEVER set this to true in production — it would show stale
# demo data to real customers if the backend goes down.
VITE_ENABLE_DEMO_FALLBACK=true
